{
  "name": "pointerscore-website",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "description": "PointerScore website with Supabase authentication and protected calculator",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run build && node scripts/check.mjs",
    "desktop:install": "npm --prefix desktop install",
    "desktop:start": "npm --prefix desktop start",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:portable": "npm --prefix desktop run build:portable"
  },
  "engines": {
    "node": ">=18"
  }
}
